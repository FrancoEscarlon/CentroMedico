<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CentroMedico.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CentroMedico.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource Primario}"
    Shell.TitleColor="{StaticResource Blanco}"
    Shell.ForegroundColor="{StaticResource Blanco}"
    Title="CEMEI">

    <!-- La primera ShellContent es la pantalla que se abre al iniciar la app -->
    <ShellContent
        Title="Ingreso"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="Login" />

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate pages:PrincipalPage}"
        Route="Principal" />

</Shell>
