<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ESTILOS SIN NOMBRE: se aplican solos a todos los controles de ese tipo -->

    <!-- Fondo de todas las pantallas -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fondo}" />
    </Style>

    <!-- Texto normal: tamaño 13 -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="TitleColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ESTILOS CON NOMBRE: se usan con Style="{StaticResource Nombre}" -->

    <!-- Textos -->
    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Primario}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Parrafo" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="Secundario" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Tarjeta blanca con borde suave -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
        <Setter Property="Stroke" Value="{StaticResource BordeSuave}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Botones -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
        <Setter Property="TextColor" Value="{StaticResource Blanco}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CelesteSuave}" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="BotonOpcion" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="BorderColor" Value="{StaticResource BordeSuave}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="BotonHorario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CelesteSuave}" />
        <Setter Property="TextColor" Value="{StaticResource TextoPrincipal}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="88" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4" />
    </Style>

</ResourceDictionary>